{
  "name": "Asteria Player",
  "short_name": "Asteria",
  "id": "./",
  "description": "Fluent Design web player for music and video with lyrics, subtitles and danmaku.",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#070a10",
  "theme_color": "#070a10",
  "categories": [
    "music",
    "video",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "播放队列",
      "short_name": "队列",
      "description": "打开当前播放队列",
      "url": "./?shortcut=queue",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "导入媒体",
      "short_name": "导入",
      "description": "打开文件选择器导入本地媒体",
      "url": "./?shortcut=import",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "设置",
      "short_name": "设置",
      "description": "打开 Asteria Player 设置",
      "url": "./?shortcut=settings",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/desktop-wide.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Asteria Player 桌面播放界面",
      "platform": "wide"
    },
    {
      "src": "screenshots/mobile-narrow.jpg",
      "sizes": "390x844",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Asteria Player 移动端播放界面",
      "platform": "narrow"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/x-wav": [
          ".wav"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "audio/aac": [
          ".aac"
        ],
        "audio/ogg": [
          ".ogg",
          ".oga",
          ".opus"
        ],
        "audio/webm": [
          ".weba"
        ],
        "audio/aiff": [
          ".aiff",
          ".aif"
        ],
        "audio/x-ms-wma": [
          ".wma"
        ],
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/webm": [
          ".webm"
        ],
        "video/x-matroska": [
          ".mkv"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/x-msvideo": [
          ".avi"
        ],
        "video/ogg": [
          ".ogv"
        ],
        "application/x-asteria-player-pack": [
          ".astpp"
        ]
      },
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
